[gd_resource type="Resource" script_class="TechDef" format=3]

[ext_resource type="Script" path="res://scripts/defs/tech_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"commercial_fusion"
display_name = "Réacteur de fusion commercial"
description = "Réacteur de fusion : électricité massive sans CO₂, à partir de deutérium et de lithium. Exige 720 h de fonctionnement d'un tokamak."
era = 7
cost = 15000
prerequisites = Array[StringName]([&"tokamak", &"deuterium", &"breeding_blanket"])
requires_building = &"tokamak"
requires_hours = 720
