[gd_resource type="Resource" script_class="BuildingDef" format=3]

[ext_resource type="Script" path="res://scripts/defs/building_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"station"
display_name = "Gare de marchandises"
description = "Point de chargement des trains, qui y sont hébergés. Les camions y déposent le surplus des producteurs proches ; les trains l'emmènent vers la gare la plus proche des clients, où les camions viennent le chercher."
category = 2
size = Vector2i(2, 2)
cost = 10000
build_hours = 72
upkeep_per_day = 60
lifetime_years = 50
required_tech = &"rail"
needs_road = true
needs_rail = true
storage_capacity = 300.0
vehicle_slots = 2
vehicle_network = 1
color = Color(0.68, 0.5, 0.38, 1)
roof_color = Color(0.36, 0.3, 0.28, 1)
height = 26.0
