[ext_resource type="Script" path="res://scripts/defs/building_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"port"
display_name = "Port"
description = "Quai de chargement des barges, qui y sont hébergées. Les camions y déposent le surplus des producteurs proches ; les barges l'emmènent par la mer, les lacs ou les rivières vers le port le plus proche des clients. Dessert aussi les chantiers d'éoliennes en mer."
category = 2
size = Vector2i(2, 2)
cost = 15000
build_hours = 96
upkeep_per_day = 70
lifetime_years = 50
required_tech = &"offshore"
needs_road = true
needs_navigable = true
storage_capacity = 400.0
vehicle_slots = 3
vehicle_network = 2
style = 7
color = Color(0.62, 0.6, 0.56, 1)
roof_color = Color(0.3, 0.42, 0.5, 1)
height = 18.0
