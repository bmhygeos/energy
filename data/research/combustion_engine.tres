[ext_resource type="Script" path="res://scripts/defs/research_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"combustion_engine"
display_name = "Moteur à explosion"
description = "Le carburant brûle dans le cylindre : un moteur léger, assez petit pour rouler sur une route."
