[gd_resource type="Resource" script_class="ResearchDef" format=3]

[ext_resource type="Script" path="res://scripts/defs/research_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"cement"
display_name = "Cimenterie"
description = "Calcaire et argile cuits au four à charbon, puis broyés : le ciment lie le béton."
tier = 4
cost = 45000.0
prerequisites = Array[StringName]([&"coke"])
effect = "Cimenterie : ciment (1 pierre et 0,25 charbon chacun). Le ciment remplace la pierre des chantiers (1 ciment pour 2 pierres, s'il y en a assez) et les bâtit deux fois plus vite."
