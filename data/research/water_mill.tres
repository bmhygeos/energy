[gd_resource type="Resource" script_class="ResearchDef" format=3]

[ext_resource type="Script" path="res://scripts/defs/research_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"water_mill"
display_name = "Moulin à eau"
description = "Une roue à aubes sur la rivière : une force régulière, sans dépendre du vent."
tier = 3
cost = 30000.0
prerequisites = Array[StringName]([&"windmill"])
effect = "Débloque le moulin à eau (au bord d'une rivière) : agriculture +30 %, coupe du bois et forges +20 %, puissance mécanique."
