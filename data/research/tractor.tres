[gd_resource type="Resource" script_class="ResearchDef" format=3]

[ext_resource type="Script" path="res://scripts/defs/research_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"tractor"
display_name = "Tracteur"
description = "Le moteur à explosion tire la charrue, la faucheuse et la remorque : un paysan cultive bien plus de terre."
tier = 4
cost = 50000.0
prerequisites = Array[StringName]([&"combustion_engine"])
effect = "Champs, lin et élevage +50 %, contre 0,03 carburant par travailleur agricole et par jour (sans carburant, le bonus baisse d'autant)."
