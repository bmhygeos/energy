[gd_resource type="Resource" script_class="ResearchDef" format=3]

[ext_resource type="Script" path="res://scripts/defs/research_def.gd" id="1_def"]

[resource]
script = ExtResource("1_def")
id = &"radioactivity"
display_name = "Radioactivité"
description = "Fission de l'atome : une poignée d'uranium vaut des montagnes de charbon."
tier = 5
cost = 200000.0
prerequisites = Array[StringName]([&"conductivity"])
effect = "Usine d'enrichissement : 5 uranium → 1 combustible nucléaire, contre du courant. Centrale nucléaire : 200 kW pour 0,4 combustible par jour, près de l'eau ; risque d'incident."
