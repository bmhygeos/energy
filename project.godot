; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.

config_version=5

[application]

config/name="Energy"
config/description="Jeu de gestion énergétique : du bois à la fusion."
config/version="0.0.1"
run/main_scene="res://scenes/main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="Energy"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://autoload/event_bus.gd"
Rng="*res://autoload/rng.gd"
GameClock="*res://autoload/game_clock.gd"
GameState="*res://autoload/game_state.gd"

[display]

window/size/viewport_width=1600
window/size/viewport_height=900
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[input]

camera_left={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":65), Object(InputEventKey,"physical_keycode":4194319)]
}
camera_right={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":68), Object(InputEventKey,"physical_keycode":4194321)]
}
camera_up={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":87), Object(InputEventKey,"physical_keycode":4194320)]
}
camera_down={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":83), Object(InputEventKey,"physical_keycode":4194322)]
}
camera_zoom_in={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194437), Object(InputEventKey,"physical_keycode":61)]
}
camera_zoom_out={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194435), Object(InputEventKey,"physical_keycode":45)]
}
camera_reset={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":4194317)]
}
overlay_cycle={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":79)]
}
time_toggle_pause={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":32)]
}
time_speed_1={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":49)]
}
time_speed_2={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":50)]
}
time_speed_4={
"deadzone": 0.2,
"events": [Object(InputEventKey,"physical_keycode":51)]
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
